{
  "name": "liquid-glass-react",
  "version": "2.0.0",
  "description": "Liquid Glass components for React: refraction through SVG backdrop filters, merging lenses, nav bars, switches, sliders. Plain JavaScript, plain CSS.",
  "type": "module",
  "main": "./index.js",
  "module": "./index.js",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./styles.css": "./styles/liquid-glass.css"
  },
  "sideEffects": [
    "./index.js",
    "**/*.css"
  ],
  "peerDependencies": {
    "motion": ">=12",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "keywords": [
    "react",
    "liquid-glass",
    "glassmorphism",
    "svg-filter",
    "refraction",
    "motion"
  ],
  "types": "./index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "styles",
    "core",
    "components",
    "lib",
    "README.md"
  ]
}